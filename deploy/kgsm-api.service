[Unit]
Description=KGSM Control Panel API
Documentation=https://github.com/TheKrystalShip
# The API aggregates the monitor's metrics; start after it (Wants, not Requires — the API
# degrades gracefully when the monitor is absent, so a monitor failure must not stop the API).
After=network.target kgsm-monitor.service
Wants=kgsm-monitor.service

[Service]
Type=simple
# Runs as the KGSM user: it spawns kgsm.sh (must be the user that owns the instances) and
# reads the monitor's socket (created by kgsm-monitor running as the same user). uid/gid 1000.
User=heisen
Group=heisen

# Framework-dependent single-file publish — REQUIRES the .NET 10 + ASP.NET Core shared runtime
# on the host (deploy/deploy.sh checks for it). Smaller artifact than self-contained; the binary,
# kgsm-api.settings.json and libe_sqlite3.so are published into /opt/kgsm-api by the deploy script:
#   dotnet publish src/Api/Api.csproj -c Release -r linux-x64 --no-self-contained
ExecStart=/opt/kgsm-api/kgsm-api
# REQUIRED: the .NET content root defaults to the process working dir. Without this it is "/"
# and kgsm-api.settings.json / kgsm-api.settings.Development.json (shipped next to the binary) are NOT
# loaded — Discord/role config silently goes missing and login 503s. Pin it to the app dir.
WorkingDirectory=/opt/kgsm-api

# Operational config (bind + paths). Secrets and host specifics live in the EnvironmentFile
# below, which is read AFTER these and therefore overrides them.
Environment=Api__Urls=http://0.0.0.0:8080
Environment=Api__KgsmPath=/usr/local/bin/kgsm
Environment=Api__KgsmJournalDir=/var/lib/kgsm/events
Environment=Api__MonitorSocketPath=/run/kgsm-monitor/metrics.sock
Environment=Api__DbPath=/var/lib/kgsm-api/kgsm-api.db
# Production by default; a host may flip this to Development in the env file to load Discord
# creds from a co-located kgsm-api.settings.Development.json instead of the env file.
Environment=ASPNETCORE_ENVIRONMENT=Production

# Secrets + host overrides: Api__SigningKey (a STABLE random key — required so
# sessions/refresh tokens survive a restart), the Discord OAuth app/guild/bot + role->tier map,
# Api__CorsOrigins (the SPA origin), Api__AuthFrontendUrl. See deploy/kgsm-api.env.example.
# Who may do what on this host, shared with every other KGSM surface. Loaded FIRST so the per-leaf
# file below can still override a value deliberately; setting one there is how a host ends up
# granting the same person different authority on different surfaces, so prefer the shared file.
# Seeded by deploy/setup.sh; optional, so a host that never provisioned it still starts.
EnvironmentFile=-/etc/kgsm/kgsm-auth.env
EnvironmentFile=-/etc/kgsm-api/kgsm-api.env

# systemd creates these owned by the service user: the DB lives under StateDirectory, the
# audit-event socket the API binds under RuntimeDirectory.
StateDirectory=kgsm-api
StateDirectoryMode=0750
RuntimeDirectory=kgsm-api
RuntimeDirectoryMode=0750
# Keep /run/kgsm-api across restarts so systemd never removes it while the API runs. Belt to the
# listener's suspenders: the kgsm-lib UnixSocketClient (1.28.0+) now self-heals if the event socket
# file is unlinked, but preserving the dir prevents the systemd-driven removal class outright.
RuntimeDirectoryPreserve=yes

Restart=always
RestartSec=2
NoNewPrivileges=true

# Kestrel terminates TLS directly (NO reverse proxy) and binds the privileged ports 80 (the
# http->https redirect) + 443 (TLS). To do that as a NON-root service, grant exactly one capability —
# CAP_NET_BIND_SERVICE (bind ports <1024) — and bound the set to nothing else. The prod env file sets
# Api__Urls=http://0.0.0.0:80;https://0.0.0.0:443 + the Kestrel cert paths (see
# deploy/kgsm-api.env.example); these lines are harmless when the unit's default http://0.0.0.0:8080
# bind is used instead. Works alongside NoNewPrivileges (systemd grants ambient caps at exec; the
# process never escalates).
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
